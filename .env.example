# mAI-Brain 설정
# 이 파일을 .env로 복사하여 실제 값을 입력하세요.
# cp .env.example .env

# ── 임베딩 프로바이더 ──────────────────────────────────────────────────────
# api: OpenAI API (text-embedding-3-small, 1536차원)
# ollama: 로컬 Ollama (nomic-embed-text, 768차원)  
# local: 로컬 bge-m3 (1024차원, 16GB+ RAM 필요)
EMBEDDING_PROVIDER=api

# OpenAI API 키 (EMBEDDING_PROVIDER=api 시 필수)
OPENAI_API_KEY=sk-xxx

# ── LLM 프로바이더 ────────────────────────────────────────────────────────
# deepseek: DeepSeek API
# ollama-cloud: ollama-cloud (또는 OpenAI 호환 엔드포인트)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat

# ── Ollama (로컬 모델 사용 시) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Qdrant 벡터DB ─────────────────────────────────────────────────────────
QDRANT_COLLECTION_NAME=mai_brain_documents

# ── 앱 설정 ───────────────────────────────────────────────────────────────
APP_NAME=mAI-Brain
FRONTEND_PORT=3000

# ── 프론트엔드 API URL ────────────────────────────────────────────────────
# Docker(nginx 프록시) 환경: 빈 문자열 (nginx가 /api를 백엔드로 프록시)
# 개발(직접 연결) 환경: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ── 인증 (JWT) ────────────────────────────────────────────────────────────
# JWT 시크릿 키 (변경 필수! 프로덕션에서는 긴 랜덤 문자열 사용)
JWT_SECRET=change-me-to-a-long-random-string-in-production

# 초기 관리자 계정 (첫 로그인 후 비밀번호 변경 권장)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
